Clear

Compile (IEEE13Nodeckt_w_loadcurve.dss)

Set ControlMode=Time

Batchedit RegControl..* maxtapchange=0

Redirect LoadShape.dss

Redirect ieee13_shape_pv_5min.dss

Redirect ieee13_pv.dss

New EnergyMeter.Feeder Line.650632 1

New Monitor.Feeder_output_vi element=Line.650632 Terminal=1 mode=0
New Monitor.Line671680_vi element=Line.671680 Terminal=2 mode=0
New Monitor.Line684611_vi element=Line.684611 Terminal=2 mode=0

New Monitor.Feeder_output_pq element=Line.650632 Terminal=1 mode=1 ppolar=no
New Monitor.Line671680_pq element=Line.671680 Terminal=2 mode=1 ppolar=no
New Monitor.Line684611_pq element=Line.684611 Terminal=2 mode=1 ppolar=no

Set mode=Daily
Set stepsize=5m
Set number=288

Set MaxControlIter=30