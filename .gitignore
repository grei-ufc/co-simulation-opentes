# Levantamento de enlaces que o TischServer grava no arranque, dentro do
# volume montado. E saida de execucao, nao fonte.
simulators/comm-opentes/tisch_links.csv

# Registro bruto da execucao dos agentes: 2,8 MB de programacoes por rodada, que
# alimentam as figuras. E saida, nao fonte.
simulators/market-opentes/data/run/

# Sensibilidade dV/dP e dV/dQ das redes geradas: 3 MB por rede, derivada do
# circuito e regenerada pelo run.sh na primeira execucao. E produto, nao fonte.
simulators/grid-opentes/src/data/*/sensitivity_day.npz

# Saidas de execucao da camada de mercado que vivem na pasta de dados do pacote:
# traco de mensagens do NET_TRACE, serie por intervalo da liquidacao e as figuras
# reproduzidas da tese. Todas se regeram com `./run.sh market` mais o
# `figuras_tese`; nenhuma e fonte.
simulators/market-opentes/data/msg_trace.csv
simulators/market-opentes/data/market_series.csv
simulators/market-opentes/data/figuras_tese/
# Confronto no a no com as Tabelas 20 e 21; sai do `comparar_demanda`.
simulators/market-opentes/data/demanda_vs_tese.csv
